# Local preview works without any accounts. Copy this file to .env.
PUBLIC_URL=http://127.0.0.1:8787
DATA_DIR=.data

# Required before exposing this workspace on a cloud host or HTTPS tunnel.
# Administrator password. At least 16 characters; can manage apps and approve writes.
WORKSPACE_PASSWORD=
# Optional member password, distinct and at least 16 characters. Members can run
# sessions and read shared results, but cannot change connections or approve writes.
WORKSPACE_MEMBER_PASSWORD=
# Google Workspace SSO. Register a Web application OAuth client with callback:
# https://your-host/auth/google/callback. Only openid/email/profile are requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=berri.ai
GOOGLE_ADMIN_EMAILS=tin@berri.ai
# Keep enabled during setup; set false after verifying a real Google admin login.
# False also invalidates previously issued password sessions.
PASSWORD_LOGIN_ENABLED=true
ORGANIZATION_NAME=Internal team
# Optional locally. Persist these values in a cloud secret store; never commit them.
# Generate SESSION_SECRET with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Generate ENCRYPTION_KEY with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SESSION_SECRET=
ENCRYPTION_KEY=

# A reachable HTTPS PUBLIC_URL and all five settings enable real cloud runs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=hermes-workspace
# Opt into Modal's VM sandbox beta for workloads needing a full kernel.
MODAL_VM_RUNTIME=false
LITELLM_API_BASE=
LITELLM_API_KEY=
AGENT_MODEL=
HERMES_REVISION=7968c72a3cb80beaae51948378944dd6e3423b96
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=1800
MAX_AGENT_ITERATIONS=30

# Optional: configure these for native "Continue with…" sign-in.
# Alternatively connect personal/integration tokens in the Connections page.
# Callback for each app: PUBLIC_URL/oauth/{linear|slack|notion}/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional Slack mention entry point. Install bot scopes app_mentions:read and
# chat:write, channels:history, groups:history. Subscribe to app_mention,
# message.channels, and message.groups at PUBLIC_URL/hooks/slack/events; reconnect.
SLACK_SIGNING_SECRET=
SLACK_BOT_ENABLED=false
SLACK_THREAD_CHAT_ENABLED=true
# Comma-separated Slack user IDs, or * for everyone in the installed workspace.
# Empty disables inbound sessions. Thread chats post answers to the source thread.
SLACK_SESSION_USERS=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
