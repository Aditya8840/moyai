From 40aa83919e999082badd1df6fafad8e85691b171 Mon Sep 17 00:00:00 2001
From: FroRaut <79215537+Froraut@users.noreply.github.com>
Date: Wed, 30 Sep 2026 03:10:46 +0300
Subject: [PATCH] fix(agent): count restarts since the last response toward the
 redirect cap

The refunding-restart cap (#106108) counted every redirect for the whole
turn, so a normal interactive turn -- the user answering clarify cards or
sending follow-ups while the model works -- ended as
redirect_restart_limit_exceeded on the (api_max_retries + 1)th mid-turn
message, even though a response completed between each of them.

The cap exists for requests that are cancelled over and over with nothing
completing. Reset restart_count whenever a response reaches processing, so
back-to-back cancelled requests still hit the bound and release the turn
lease, while corrections separated by real progress no longer kill the turn.

Fixes #128000

(cherry picked from commit 3a286a2201ee055b2eb6904523934f60e5e1344c)

Runtime-only backport for Moyai; regression coverage lives in tests/hermes_steering_probe.py.

diff --git a/agent/conversation_loop.py b/agent/conversation_loop.py
index b88367a7963d..d88600832e5b 100644
--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -1417,10 +1417,10 @@ class _LoopState:
     failed: bool = False
     codex_ack_continuations: int = 0
     length_continue_retries: int = 0
-    # Per-turn backstop for the refunding restarts (redirect / rebuilt-for-fallback).
-    # Unlike ``retry_count`` (rebound to 0 each iteration) this accumulates for the whole
-    # turn so a runaway interrupt/redirect that keeps re-arming a restart flag cannot
-    # refund the iteration budget forever and hold the turn lease indefinitely.
+    # Backstop for the refunding restarts (redirect / rebuilt-for-fallback). Unlike
+    # ``retry_count`` (rebound to 0 each iteration) this survives across iterations until a
+    # response arrives, so a runaway interrupt/redirect that keeps re-arming a restart flag
+    # cannot refund the iteration budget forever and hold the turn lease indefinitely.
     restart_count: int = 0
     _outer_error_count: int = 0  # outer-loop exceptions this turn (#92450), see _MAX_OUTER_LOOP_ERRORS
     truncated_tool_call_retries: int = 0
diff --git a/agent/turn_iteration_prep.py b/agent/turn_iteration_prep.py
index 2ee6cfa30fee..1dbc05282f83 100644
--- a/agent/turn_iteration_prep.py
+++ b/agent/turn_iteration_prep.py
@@ -539,4 +539,9 @@ def _verdict(action: str) -> RetryRestartVerdict:
         agent._emit_diagnostic_status("❌ The model provider didn't answer after all retries. Send /retry, or switch models with /model.")
         agent._persist_session(messages, conversation_history)
         return _verdict("break")
+    # A response arrived, so the turn is not stuck re-issuing a cancelled request: start
+    # the refunding-restart bound over (restart_count = restarts since the last response).
+    # Counting every mid-turn correction for the whole turn ended healthy interactive
+    # turns on the (max_retries + 1)th message (#128000).
+    restart_count = 0
     return _verdict("fallthrough")
